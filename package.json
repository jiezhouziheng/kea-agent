{
  "name": "kea-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.7",
  "files": ["dist"],
  "bin": {
    "kea": "dist/src/main.js"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "bun scripts/clean.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bun run clean && bun --bun tsc -p tsconfig.build.json",
    "test": "bun test",
    "start": "bun dist/src/main.js",
    "verify:dist": "bun scripts/verify-dist.ts",
    "verify:global": "bun scripts/verify-global.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@google/genai": "2.12.0",
    "@opentui/core": "0.5.8",
    "@opentui/react": "0.5.8",
    "openai": "6.48.0",
    "react": "19.2.8",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  }
}
